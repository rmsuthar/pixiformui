{
  "name": "pixiform",
  "private": true,
  "version": "0.1.9",
  "type": "module",
  "description": "Secure JavaScript form library rendered on canvas: encrypted passwords, shared validation, accessible, zero dependencies",
  "scripts": {
    "dev": "node --experimental-strip-types --no-warnings=ExperimentalWarning server/server.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node --experimental-strip-types --no-warnings=ExperimentalWarning server/server.ts",
    "serve": "npm run build && npm run start",
    "typecheck": "tsc --noEmit",
    "test:pfe": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/pfe-test.ts",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test \"tests/**/*.test.ts\"",
    "build:lib": "rm -rf dist-lib && tsc -p tsconfig.lib.json && vite build --config vite.lib.config.ts && vite build --config vite.lib.config.ts --mode standalone && vite build --config vite.lib.config.ts --mode ssr && node scripts/lib-package.mjs",
    "mcp": "node --experimental-strip-types --no-warnings=ExperimentalWarning server/mcp.ts",
    "build:site": "tsc --noEmit && npm run build:lib && node scripts/build-site.mjs",
    "deploy:site": "npm run build:site && wrangler deploy && node scripts/indexnow.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "test:e2e": "playwright test",
    "stats": "node scripts/stats.mjs",
    "size": "node scripts/size-check.mjs",
    "docs:images": "node scripts/doc-images.mjs",
    "waitlist": "node scripts/waitlist.mjs",
    "snyk": "snyk test --org=6c00c6c3-d03f-4baf-8076-434221c1ddc4 && snyk code test --org=6c00c6c3-d03f-4baf-8076-434221c1ddc4",
    "snyk:report": "snyk monitor --org=6c00c6c3-d03f-4baf-8076-434221c1ddc4 --project-name=pixiform && snyk code test --org=6c00c6c3-d03f-4baf-8076-434221c1ddc4 --report --project-name=pixiform"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.5.0",
    "@playwright/test": "1.65.1",
    "@types/node": "^22.20.5",
    "esbuild": "0.28.2",
    "marked": "18.2.1",
    "terser": "^5.51.4",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "wrangler": "4.168.0"
  },
  "engines": {
    "node": ">=22.6"
  },
  "license": "MIT",
  "homepage": "https://pixiformui.lets.gen.in",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rmsuthar/pixiformui.git"
  },
  "bugs": {
    "url": "https://github.com/rmsuthar/pixiformui/issues",
    "email": "ravindra.suthar@me.com"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
