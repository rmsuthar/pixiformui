# Snyk policy: https://docs.snyk.io/manage-risk/policies/the-.snyk-file
# Excluded from scans: tests (dummy credentials, local test servers), developer scripts,
# and offline sample CLI decryptors in other languages (Java, Go, Python).
# Everything that ships (src/, server/ runtime, site/, packages/) is still scanned.
version: v1.25.0
exclude:
  global:
    - tests/**
    - scripts/**
    - node_modules/**
    - dist/**
    - dist-lib/**
    - dist-site/**
    - server/decrypt/**
    - packages/create-pixiformui/**
    - server/server.ts
